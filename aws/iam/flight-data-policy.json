{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Sid": "Secrets",
   "Effect": "Allow",
   "Action": "secretsmanager:GetSecretValue",
   "Resource": "arn:aws:secretsmanager:us-east-1:787712140444:secret:flight/*"
  },
  {
   "Sid": "DynamoDB",
   "Effect": "Allow",
   "Action": [
    "dynamodb:PutItem",
    "dynamodb:UpdateItem",
    "dynamodb:GetItem",
    "dynamodb:Query",
    "dynamodb:Scan"
   ],
   "Resource": [
    "arn:aws:dynamodb:us-east-1:787712140444:table/subscriptions",
    "arn:aws:dynamodb:us-east-1:787712140444:table/notification_history"
   ]
  },
  {
   "Sid": "RoutesConfig",
   "Effect": "Allow",
   "Action": [
    "s3:GetObject"
   ],
   "Resource": "arn:aws:s3:::flight-config-787712140444/*"
  },
  {
   "Sid": "QueueProducers",
   "Effect": "Allow",
   "Action": [
    "sqs:SendMessage",
    "sqs:GetQueueUrl"
   ],
   "Resource": [
    "arn:aws:sqs:us-east-1:787712140444:flight-fare-queue",
    "arn:aws:sqs:us-east-1:787712140444:flight-status-queue"
   ]
  },
  {
   "Sid": "QueueConsumers",
   "Effect": "Allow",
   "Action": [
    "sqs:ReceiveMessage",
    "sqs:DeleteMessage",
    "sqs:GetQueueAttributes"
   ],
   "Resource": [
    "arn:aws:sqs:us-east-1:787712140444:flight-fare-queue",
    "arn:aws:sqs:us-east-1:787712140444:flight-status-queue"
   ]
  },
  {
   "Sid": "FanOut",
   "Effect": "Allow",
   "Action": "lambda:InvokeFunction",
   "Resource": "arn:aws:lambda:us-east-1:787712140444:function:flight-parser"
  }
 ]
}